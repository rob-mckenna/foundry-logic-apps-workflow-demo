# Foundry project endpoint — format: https://<resource>.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment inside the Foundry project (must support tool calling).
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Populated by scripts/deploy.ps1. Used to render the OpenAPI spec at load time.
LOGIC_APP_HOSTNAME=
TENANT_ID=

# Audience the OpenAPI tool requests a token for.
AUDIENCE=api://prior-auth-api

# Agent metadata
AGENT_NAME=prior-auth-assistant
