# Foundry project endpoint — format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment inside the Foundry project.
# Must be a model that supports OpenAPI tools — gpt-4.1 is the safe default.
# gpt-5-mini technically works via SDK but the Foundry portal flags it as
# "Not supported by the selected model" for OpenAPI tools.
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Populated by scripts/deploy-consumption.ps1 (Consumption variant).
# For Standard variant, LOGIC_APP_HOSTNAME is used instead of OPENAPI_PATH.
LOGIC_APP_HOSTNAME=
TENANT_ID=

# Audience the OpenAPI tool requests a token for (api://<appId>).
AUDIENCE=

# Agent metadata
AGENT_NAME=prior-auth-assistant

# Optional: path to the deployed OpenAPI spec (Consumption variant writes this).
# Defaults to workflows/prior-auth-status-check/openapi.yaml (Standard variant).
OPENAPI_PATH=
